# 生产构建配置（vite build 自动读取）
#
# 当前生产部署形态：前端独立容器（https://xmmvgkanfsux.sealoshzh.site，entrypoint.sh 跑 server.js 托管 dist），
# 后端独立部署（https://dzdqdodqktpq.sealoshzh.site），构建期把后端地址烘焙进产物。
# 直接 npm run build 即可，无需手动传变量。
VITE_API_BASE_URL=https://dzdqdodqktpq.sealoshzh.site
#
# 若未来改为「同源部署」（dist 由后端域名托管，REST/Socket/上传全走相对路径），
# 删除/注释上面的 VITE_API_BASE_URL 即可，默认 '' = 同源。
