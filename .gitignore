# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-desktop/
release/
# electron-builder 资源目录，只入库应用图标与安装器品牌图（BMP 为生成产物）
/build/*
!/build/icon-mac.png
!/build/icon-win.png
!/build/installerSidebar.bmp
!/build/uninstallerSidebar.bmp
!/build/installerHeader.bmp
!/build/installer.nsh
# 侧边栏图生成用字体（8MB，不入库）；下载：
# https://github.com/google/fonts/raw/main/ofl/notosanssc/NotoSansSC%5Bwght%5D.ttf
/build/fonts/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Cache
.cache/
.temp/
tmp/
